# Copy to .env and fill in. Never commit .env.

# --- Postgres ---
POSTGRES_USER=catastif
# Use a URL-safe value, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=catastif
# Only for local dev (npm run dev / tests). Compose builds its own URL from the values above.
DATABASE_URL=postgres://catastif:change-me-long-random@localhost:5432/catastif
TEST_DATABASE_URL=postgres://catastif:change-me-long-random@localhost:5432/catastif_test

# --- App ---
# One-time token required to create the password on first visit to /login.
SETUP_TOKEN=change-me-long-random
# Timezone used for "today" and scheduled jobs.
APP_TZ=Europe/Bucharest
SESSION_DAYS=30
# true when served over HTTPS (e.g. `tailscale serve`); false for plain http over Tailscale.
COOKIE_SECURE=false
# How far ahead recurring rules create planned transactions.
RECURRING_HORIZON_MONTHS=12

# --- Network ---
# Tailscale IP of the Unraid box. App and DB GUI bind only to this address.
TAILSCALE_IP=100.64.0.1
APP_PORT=3000
ADMINER_PORT=8081

# --- Storage (Unraid) ---
DATA_DIR=/mnt/user/appdata/catastif

# --- Backups ---
BACKUP_DIR=/mnt/user/backups/catastif
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3

# --- Worker ---
# When the daily bill.overdue / task.overdue webhook events are sent (cron, APP_TZ).
DIGEST_CRON=0 8 * * *

# --- n8n (optional: docker compose --profile n8n up -d) ---
N8N_PORT=5678
N8N_VERSION=latest
# Public URL n8n shows for its webhook nodes, if n8n is reachable from outside.
N8N_WEBHOOK_URL=

# --- AI (Inbox drafts) ---
# "anthropic" or "parser" (no AI; local one-line parser). Defaults to anthropic when a key is set.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
