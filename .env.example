# Copy to .env and fill in. Never commit .env.

# --- Postgres ---
POSTGRES_USER=catastif
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=catastif
# Used by the app/worker inside compose (host "db"). For local dev use localhost.
DATABASE_URL=postgres://catastif:change-me-long-random@db:5432/catastif

# --- App ---
# One-time token required to create the password on first visit to /login.
SETUP_TOKEN=change-me-long-random
# Timezone used for "today" and scheduled jobs.
APP_TZ=Europe/Bucharest
SESSION_DAYS=30
# true when served over HTTPS (e.g. `tailscale serve`); false for plain http over Tailscale.
COOKIE_SECURE=false
# How far ahead recurring rules create planned transactions.
RECURRING_HORIZON_MONTHS=12

# --- Network ---
# Tailscale IP of the Unraid box. App and DB GUI bind only to this address.
TAILSCALE_IP=100.64.0.1
APP_PORT=3000
ADMINER_PORT=8081

# --- Backups ---
BACKUP_DIR=/mnt/user/backups/catastif
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
