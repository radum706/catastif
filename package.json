{
  "name": "catastif",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "worker": "node --env-file-if-exists=.env --import tsx worker/index.ts",
    "build:worker": "esbuild worker/index.ts scripts/migrate.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --tsconfig=tsconfig.json --banner:js=\"import{createRequire}from\\\"module\\\";const require=createRequire(import.meta.url);\" --out-extension:.js=.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
